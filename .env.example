# The orders Apps Script web app (the same /exec URL as the website's ORDERS_SCRIPT_URL).
EXPO_PUBLIC_ORDERS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# The app-only key (APP_KEY in Code.gs). Never put the script's SECRET here: this value ships inside the app.
EXPO_PUBLIC_ORDERS_APP_KEY=
